{
  app: {
    products: [
      {
        name: 'default',
        compatibleSdkVersion: '5.0.0(12)',
        targetSdkVersion: '6.0.0(20)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          nativeCompiler: 'BiSheng',
          strictMode: {
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
    signingConfigs: [],
  },
  modules: [
    {
      name: 'jpush_react_native',
      srcPath: '../node_modules/@react-native-ohos/jpush-react-native/harmony/jpush_react_native',
    },
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: ['default'],
        },
      ],
    },
  ],
}
