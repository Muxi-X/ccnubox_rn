{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "sortImports": true,
  "ignorePatterns": [
    "secret/**",
    "assets/**",
    ".expo/**",
    ".husky/**",
    ".vscode/**",
    ".github/**",
    // These files are owned by expo-harmony-toolkit; reformatting them breaks
    // the managed-file hashes used by sync-template's drift detection.
    ".expo-harmony/**",
    "harmony/**",
    "index.harmony.js",
    "metro.harmony.config.js",
    "dist/**",
    "package.json",
    "pnpm-lock.yaml",
    "node_modules/**",
    "android/**",
    "ios/**",
    "modules/**/build/**",
    "targets/**",
  ],
}
