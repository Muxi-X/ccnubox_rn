{
  "cli": {
    "version": ">= 10.2.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "DISABLE_CODE_SIGNING": "true"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "channel": "simulator",
      "ios": {
        "simulator": true
      }
    },
    "test": {
      "channel": "test",
      "env": {
        "GOOGLE_SERVICES_JSON": "${EAS_ENV.GOOGLE_SERVICES_JSON}"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "store",
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "auto",
        "scheme": "ccnubox"
      }
    }
  },
  "submit": {
    "production": {},
    "test": {
      "ios": {
        "ascAppId": "6689522026"
      }
    },
    "development": {}
  }
}
