EXPO_PUBLIC_API_URL=http://your-api-url/api/v1
EXPO_PUBLIC_FEEDBACK_BASE_URL=https://feedback.xxxx.com
EXPO_PUBLIC_FEEDBACK_PARENT_NODE=your_feedback_parent_node
# 日志脱敏开关（默认开启，仅当显式设为 false 时关闭脱敏）
EXPO_PUBLIC_LOG_REDACTOR=true

# JPush 配置
JPUSH_APP_KEY=your_jpush_app_key
JPUSH_CHANNEL=your_channel_name
JPUSH_PKGNAME=com.your.app

# JPush 厂商通道配置

# Vivo
JPUSH_VIVO_APP_KEY=xxx
JPUSH_VIVO_APP_ID=xxx

# Xiaomi
JPUSH_XIAOMI_APP_ID=xxx
JPUSH_XIAOMI_APP_KEY=xxx

# OPPO
JPUSH_OPPO_APP_KEY=OP-xxx
JPUSH_OPPO_APP_ID=OP-xxx
JPUSH_OPPO_APP_SECRET=OP-xxx

# Honor
JPUSH_HONOR_APP_ID=xxx
